<!DOCTYPE html>
<html>
  <head>
    <title><%= [ content_for(:title), "adavra" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Adavra Sales">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Geist and Geist Mono, the fonts of the portal design %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <header class="border-b border-line">
        <div class="mx-auto max-w-[1120px] px-4 sm:px-6 h-[72px] flex items-center justify-between gap-6">
          <%= link_to root_path, class: "flex items-center gap-2.5" do %>
            <span class="grid place-items-center size-6 rounded-md bg-primary text-sm font-semibold">a</span>
            <span class="text-base font-semibold tracking-[-0.02em]">adavra</span>
            <span class="hidden sm:inline text-[13px] text-subtle">Back-office</span>
          <% end %>

          <div class="flex items-center gap-2">
            <div class="flex items-center gap-2.5">
              <span class="grid place-items-center size-8 rounded-full bg-surface border border-line-strong text-[11px] font-semibold text-muted">
                <%= initials(Current.user.name) %>
              </span>
              <span class="hidden sm:flex flex-col gap-px">
                <span class="text-[13px] font-medium"><%= Current.user.name %></span>
                <span class="text-xs text-subtle"><%= status_label(Current.user.role) %></span>
              </span>
            </div>
            <%= button_to "Salir", session_path, method: :delete, class: "btn-ghost px-4 py-2" %>
          </div>
        </div>

        <% if Current.user.staff? %>
          <nav aria-label="Secciones" class="mx-auto max-w-[1120px] px-4 sm:px-6 pb-3 flex gap-1 overflow-x-auto">
            <% admin_nav_items.each do |label, path| %>
              <%= admin_nav_link(label, path) %>
            <% end %>
          </nav>
        <% end %>
      </header>
    <% end %>

    <main class="mx-auto max-w-[1120px] px-4 sm:px-6 pt-9 pb-18">
      <% if notice || alert %>
        <div class="<%= "max-w-md mx-auto" unless authenticated? %>">
          <% if notice %><p class="flash flash-notice" role="status"><%= notice %></p><% end %>
          <% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
