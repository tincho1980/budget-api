<% content_for :title, "Ingresar" %>

<div class="grid lg:grid-cols-[1fr_400px] gap-12 lg:gap-24 items-center min-h-[calc(100vh-180px)]">
  <section class="hidden lg:block">
    <div class="flex items-center gap-2.5 mb-24">
      <span class="grid place-items-center size-6 rounded-md bg-primary text-sm font-semibold">a</span>
      <span class="text-base font-semibold tracking-[-0.02em]">adavra</span>
    </div>
    <h2 class="text-[40px] leading-[1.1] font-semibold tracking-[-0.03em] max-w-md">Presupuestos, horas y cobranza en un solo lugar.</h2>
    <p class="text-muted mt-5 max-w-md leading-relaxed">
      El back-office del equipo: armá y enviá presupuestos, cargá horas, seguí las cuotas de mantenimiento y confirmá los pagos que informan los clientes.
    </p>
  </section>

  <section class="w-full max-w-md mx-auto">
    <p class="eyebrow mb-3">Back-office</p>
    <h1 class="page-title">Ingresar</h1>
    <p class="page-subtitle mb-8">Usá el email y la contraseña de tu cuenta del equipo.</p>

    <%= form_with url: session_url do |form| %>
      <div class="form-field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "tu@adavra.com", value: params[:email_address], class: "form-input max-w-none" %>
      </div>

      <div class="form-field">
        <%= form.label :password, "Contraseña" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "form-input max-w-none" %>
      </div>

      <%= form.submit "Ingresar", class: "btn-primary btn-lg w-full mt-2", data: { turbo_submits_with: "Ingresando…" } %>
    <% end %>

    <p class="mt-6 text-[13px] text-subtle">
      <%= link_to "¿Olvidaste tu contraseña?", new_password_path, class: "link" %>
    </p>
  </section>
</div>
