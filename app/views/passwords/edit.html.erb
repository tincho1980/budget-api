<% content_for :title, "Nueva contraseña" %>

<section class="max-w-md mx-auto pt-12">
  <h1 class="page-title">Elegí una contraseña nueva</h1>
  <p class="page-subtitle mb-8">Al guardarla se cierran las sesiones abiertas en otros dispositivos.</p>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="form-field">
      <%= form.label :password, "Contraseña nueva" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "form-input max-w-none" %>
    </div>

    <div class="form-field">
      <%= form.label :password_confirmation, "Repetila" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-input max-w-none" %>
    </div>

    <%= form.submit "Guardar", class: "btn-primary btn-lg w-full mt-2", data: { turbo_submits_with: "Guardando…" } %>
  <% end %>
</section>
