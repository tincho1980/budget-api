<% if record.errors.any? %>
  <div class="flash flash-alert" role="alert">
    <p class="font-semibold">No se pudo guardar:</p>
    <ul class="list-disc ml-5 mt-1 font-normal">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
